{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "televole-live",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "63ba7ddbe8724a0a4579bf01c91c3aa8",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "adsparty.com", "custom_domain": true },
    { "pattern": "www.adsparty.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "STATION", "class_name": "Station" },
      { "name": "MEDIA_PACKAGER", "class_name": "MediaPackager" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Station"] },
    { "tag": "v2", "new_sqlite_classes": ["MediaPackager"] },
  ],
  "containers": [
    {
      "class_name": "MediaPackager",
      "image": "registry.cloudflare.com/63ba7ddbe8724a0a4579bf01c91c3aa8/televole-live-mediapackager@sha256:beb1a8b28e381fc74cc6de3523c556d2f5cd78c1d00574dc041744165c0e3a46",
      "max_instances": 1,
      "instance_type": "basic",
      "constraints": { "regions": ["WEUR", "EEUR"] },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "televole-db",
      "database_id": "9ca12870-5ad3-4b0c-a21c-0648e06a2d7e",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "televole-media" }],
  "queues": {
    "producers": [
      { "binding": "GENERATION_QUEUE", "queue": "televole-generation" },
      { "binding": "PACKAGING_QUEUE", "queue": "televole-packaging" },
    ],
    "consumers": [
      {
        "queue": "televole-generation",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "televole-generation-dlq",
      },
      {
        "queue": "televole-packaging",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "televole-packaging-dlq",
      },
    ],
  },
  "vars": {
    "BRAND_NAME": "adsparty",
    "FAL_MODEL": "minimax/h3-max/text-to-video",
    "FAL_DURATION": "5",
    "FAL_RESOLUTION": "768P",
    "FAL_ASPECT_RATIO": "16:9",
    "FAL_PROMPT_EXPANSION": "balanced",
    "VIDEO_PROVIDER": "wiro",
    "WIRO_RESOLUTION": "768P",
    "WIRO_RATIO": "16:9",
    "DIRECTOR_PROVIDER": "deterministic",
    "DIRECTOR_MODEL": "",
    "DIRECTOR_BASE_URL": "",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEhUQsgz_b94lH6G",
    "GA_MEASUREMENT_ID": "G-4TXMPPH4LQ",
    "STRIPE_ENABLED": "false",
    "STRIPE_PRICE_ID": "",
  },
  "observability": { "enabled": true },
}
